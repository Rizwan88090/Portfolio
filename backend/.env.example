# Server
PORT=4000
FRONTEND_URL=http://localhost:3000

# PostgreSQL. This machine has PG18 on port 5433 with database "pentagon".
# Replace YOUR_PASSWORD with the "postgres" password set during PostgreSQL install.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/pentagon
DB_SYNC=true
DB_SSL=false

# Initial password for admins created on first start (see src/auth/admins.seed.ts).
# Each admin should change it from the dashboard. Existing passwords are never overwritten.
ADMIN_DEFAULT_PASSWORD=choose-a-strong-initial-password
# Set to true in production when the site is served over HTTPS.
COOKIE_SECURE=false
